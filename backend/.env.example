# Copy to .env (never commit .env). Production values go in your host's secret store.
ENVIRONMENT=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Required in production, at least 32 random characters: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Comma-free JSON list of allowed portal origins, e.g. ["https://app.example.com"]
CORS_ORIGINS=["https://YOUR-PORTAL-DOMAIN"]
PORTAL_BASE_URL=https://YOUR-PORTAL-DOMAIN

# Email (check-in reminders, verification). Reminder job exits 1 if these are missing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Private document storage. Leave unset only for local development.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_STORAGE_BUCKET_NAME=
# If not using S3, a persistent disk path (containers lose local files on restart):
PERSISTENT_UPLOAD_DIR=

# Company registry lookup (falls back to manual verification when unset)
CIPC_API_URL=
CIPC_API_KEY=
